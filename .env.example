# Variables de entorno del portfolio (Vite expone al bundle solo las VITE_*).
# Copiá este archivo a .env.local para desarrollo. En producción se cargan en
# Vercel (proyecto "portfolio", entorno Production). Ojo: todas las VITE_* quedan
# PÚBLICAS en el bundle; no pongas secretos acá.

# URL del receptor de leads del configurador (Google Apps Script, implementación
# web "/exec"). Sin esta variable el configurador muestra la pantalla de error.
VITE_WEBHOOK_URL=https://script.google.com/macros/s/TU_ID_DE_IMPLEMENTACION/exec

# Número de WhatsApp de respaldo (pantalla de error), formato internacional sin
# "+" ni espacios. Argentina celular: 54 9 + característica + número.
# Sin esta variable el botón de WhatsApp no se muestra.
VITE_WHATSAPP_NUMBER=5492610000000

# Email de contacto (aviso de privacidad y alternativa mailto). Opcional:
# si falta, se usa el email por defecto definido en el código.
VITE_CONTACT_EMAIL=tu@email.com
