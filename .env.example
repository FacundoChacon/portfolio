# Variables de entorno del portfolio + configurador (Vite).
#
# IMPORTANTE: las variables con prefijo VITE_ se EMBEBEN en el bundle y son PÚBLICAS.
# No pongas acá secretos, tokens ni credenciales.
# Copiá este archivo a `.env` y completá los valores reales.

# variable pública (se embebe en el bundle); no poner secretos
# URL del webhook (n8n / Zapier / Make) que recibe el lead del configurador.
VITE_WEBHOOK_URL=https://example.com/webhook/lead

# variable pública (se embebe en el bundle); no poner secretos
# Número de WhatsApp de respaldo para el modo degradado (formato internacional, solo dígitos).
VITE_WHATSAPP_NUMBER=5492612345678

# variable pública (se embebe en el bundle); no poner secretos
# Email de respaldo para el fallback `mailto:`.
VITE_CONTACT_EMAIL=tu-email@ejemplo.com

# variable pública (se embebe en el bundle); no poner secretos
# URL canónica del sitio (usada en el PDF del presupuesto y metadatos).
VITE_APP_URL=https://www.facucode.dev
